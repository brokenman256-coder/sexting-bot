# Get a key at https://console.x.ai
XAI_API_KEY=xai-your-key-here

# Admin portal password (/admin)
ADMIN_PASSWORD=nightline-admin

# JWT secret for user session cookies (change in production!)
AUTH_SECRET=change-me-to-a-long-random-string

# Optional: default credits for new signups
DEFAULT_CREDITS=50

# Optional chat model
# XAI_CHAT_MODEL=grok-4.5
