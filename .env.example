# Free chat (recommended): https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-key-here

# Paid alternative (xAI Grok): https://console.x.ai
# XAI_API_KEY=xai-your-key-here
# Or paste a Groq gsk_ key into XAI_API_KEY — auto-detected

# Admin account (seeded on first boot / cold start)
ADMIN_EMAIL=brokenman256@gmail.com
ADMIN_PASSWORD=changeme123

# JWT secret for user session cookies (change in production!)
AUTH_SECRET=change-me-to-a-long-random-string

# Optional: default credits for new signups
DEFAULT_CREDITS=50

# Optional chat model override
# Groq defaults: llama-3.3-70b-versatile
# CHAT_MODEL=llama-3.3-70b-versatile
# XAI_CHAT_MODEL=grok-4.5
