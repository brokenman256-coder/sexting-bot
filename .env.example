# Free chat (recommended): https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-key-here

# Paid alternative (xAI Grok): https://console.x.ai
# XAI_API_KEY=xai-your-key-here
# Or paste a Groq gsk_ key into XAI_API_KEY — auto-detected

# Admin account (seeded on first boot / cold start)
ADMIN_EMAIL=brokenman256@gmail.com
ADMIN_PASSWORD=changeme123

# JWT secret for user session cookies (change in production!)
AUTH_SECRET=change-me-to-a-long-random-string

# Optional: default credits for new signups
DEFAULT_CREDITS=50

# Optional chat model override
# Groq defaults: llama-3.3-70b-versatile
# CHAT_MODEL=llama-3.3-70b-versatile
# XAI_CHAT_MODEL=grok-4.5

# ── Optional: explicit-content provider (levels 2+) ─────────────────────────
# Any OpenAI-compatible host that permits legal adult content:
#   Novita:     NSFW_BASE_URL=https://api.novita.ai/v3/openai
#   DeepInfra:  NSFW_BASE_URL=https://api.deepinfra.com/v1
#   Local Ollama (uncensored model, e.g. l3-8b-stheno):
#               NSFW_BASE_URL=http://localhost:11434/v1
# NSFW_API_KEY=your-provider-key
# NSFW_BASE_URL=https://api.novita.ai/v3/openai
# NSFW_CHAT_MODEL=sao10k/l3-euryale-70b
# Level 1 (tease) keeps using GROQ/XAI — fast and free. Levels 2-3 route
# to this provider when it's configured, falling back to the default
# provider otherwise. Verify the provider's ToS + current model IDs.
